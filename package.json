{
  "name": "@local/dsh-prompt-enhancer",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "In-composer prompt enhancement for DeepSeek Harness: rewrite a rough draft into a clear, structured prompt with a before/after comparison, one-click replace, and copy.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}
